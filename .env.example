# Google Cloude Platform 프로젝트 ID
EE_PROJECT_ID=your-earth-engine-project-id

# 안전데이터 서비스 키 (https://www.safetydata.go.kr/에서 발급)
LANDSLIDE_SERVICE_KEY=your-safetydata-service-key
FORESTFIRE_SERVICE_KEY=your-safetydata-service-key

YEAR=2024
OUTPUT_HTML=seoul_flood_risk_rf.html
ANALYSIS_SCALE=30
SEOUL_REFERENCE_GEOJSON=seoul_flood_reference_points.geojson
POSITIVE_POINTS=200
NEGATIVE_POINTS=200
NEGATIVE_BUFFER_M=300
POSITIVE_BUFFER_M=60
HOTSPOT_PERCENTILE=95

# GTB soft voting
GTB_VOTING_SEEDS=13,23,37

# 하이퍼파라미터 튜닝을 실행하려면 1로 변경
RUN_HYPERPARAMETER_TUNING=0
GTB_TUNING_METRIC=pr_auc_mean
GTB_TUNING_FOLDS=0,1,2,3,4
# 튜닝 단계는 계산량을 줄이기 위해 기본적으로 seed 1개만 사용
GTB_TUNING_SEEDS=13

# Optuna TPE 탐색 설정
GTB_OPTUNA_TRIALS=20
GTB_OPTUNA_RANDOM_SEED=42
GTB_OPTUNA_STARTUP_TRIALS=5
GTB_OPTUNA_PRUNING=1
GTB_OPTUNA_WARMUP_FOLDS=2
GTB_OPTUNA_TREES_MIN=50
GTB_OPTUNA_TREES_MAX=300
GTB_OPTUNA_TREES_STEP=25
GTB_OPTUNA_SHRINKAGE_MIN=0.01
GTB_OPTUNA_SHRINKAGE_MAX=0.15
GTB_OPTUNA_SAMPLING_RATE_MIN=0.5
GTB_OPTUNA_SAMPLING_RATE_MAX=1.0
GTB_OPTUNA_MAX_NODES_CHOICES=8,16,32,64
